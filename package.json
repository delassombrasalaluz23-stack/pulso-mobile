    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node tests/navigation.mjs && node tests/backend.mjs && node tests/client.mjs && node tests/edge.mjs && node tests/launch.mjs",
    "export:native": "expo export --platform android --platform ios",
    "preview:go": "expo start --go --tunnel",
    "check:ios": "node --env-file-if-exists=.env scripts/check-ios.mjs",
    "ios:preview": "npm run check:ios && npx eas-cli@latest build --platform ios --profile preview",
    "android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:stores": "npx eas-cli@latest build --platform all --profile production",
    "bundle:map": "node scripts/bundle-leaflet.mjs"
  },
  "private": true
}
